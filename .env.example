# AI Knowledge Vault — environment variables (docs/DEPLOYMENT.md §4)
# Copy to .env.local for development. NEVER commit real values.

# ---- Environment ----
APP_ENV=development                 # development | test | staging | production
LOG_LEVEL=info                      # fatal | error | warn | info | debug | trace | silent
NEXT_TELEMETRY_DISABLED=1           # no third-party telemetry (ARCHITECTURE_REVIEW F-11)

# ---- Origins (must differ: untrusted previews are served from PREVIEW_ORIGIN, ADR-007) ----
APP_ORIGIN=http://localhost:3000
PREVIEW_ORIGIN=http://127.0.0.1:3000

# ---- Database (PostgreSQL / Neon) ----
DATABASE_URL=postgres://vault:vault@127.0.0.1:5432/vault_dev
# DATABASE_URL_DIRECT=             # Neon non-pooled URL for migrations (optional locally)
DATABASE_URL_TEST=postgres://vault:vault@127.0.0.1:5432/vault_test
DATABASE_POOL_MAX=10

# ---- Secrets (each ≥ 32 chars, all different: `openssl rand -base64 48`) ----
BETTER_AUTH_SECRET=replace-me-with-a-long-random-value-0000000001
PREVIEW_TOKEN_SECRET=replace-me-with-a-long-random-value-0000000002
LOCAL_STORAGE_SIGNING_SECRET=replace-me-with-a-long-random-value-0000000003
# TRUSTED_PROXIES=10.0.0.0/8        # reverse-proxy IPs/CIDRs (login rate limiting keys on client IP)

# ---- Object storage ----
STORAGE_DRIVER=local                # local | s3 (Cloudflare R2 or any S3 API)
LOCAL_STORAGE_DIR=./.data/storage
# ALLOW_LOCAL_STORAGE_IN_PRODUCTION=false   # only for a VPS with a persistent volume
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=vault-prod
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# ---- Import limits (defaults shown) ----
# IMPORT_MAX_FILE_BYTES=209715200
# EXTRACT_MAX_BYTES=52428800
# IMPORT_MAX_ITEMS_PER_BATCH=500
# IMPORT_ITEM_TIMEOUT_MS=300000
# UPLOAD_URL_TTL_SECONDS=900
# ZIP_MAX_ENTRIES=5000
# ZIP_MAX_TOTAL_UNCOMPRESSED_BYTES=536870912
# ZIP_MAX_ENTRY_BYTES=134217728
# ZIP_MAX_COMPRESSION_RATIO=200
# ZIP_MAX_PATH_DEPTH=24
# PDF_MAX_PAGES=2000
# PREVIEW_MAX_FILES=2000
# PREVIEW_MAX_TOTAL_BYTES=268435456
# IMAGE_MAX_INPUT_PIXELS=100000000

# Backup (BACKUP_RECOVERY.md)
# EXPORT_JOB_TIMEOUT_MS=1800000
# RESTORE_MAX_ENTRIES=200000
# RESTORE_MAX_TOTAL_BYTES=53687091200

# ---- Worker ----
# WORKER_CONCURRENCY=2
# WORKER_POLL_INTERVAL_MS=1000
# WORKER_SHUTDOWN_GRACE_MS=30000
# JOB_LEASE_SECONDS=120
# WORKER_HEALTH_PORT=3901          # localhost-only GET /healthz for container health checks
