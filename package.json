{
  "name": "ai-knowledge-vault",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker:dev": "tsx watch --env-file-if-exists=.env.local src/worker/main.ts",
    "build:node": "tsx scripts/build-node.ts",
    "worker:start": "node dist/worker.mjs",
    "db:migrate:prod": "node dist/db-migrate.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "storage:verify": "vitest run --config vitest.storage.config.ts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/db-migrate.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "admin:create": "tsx --env-file-if-exists=.env.local scripts/admin-create.ts",
    "admin:create:prod": "node dist/admin-create.mjs",
    "backup:export": "tsx --env-file-if-exists=.env.local scripts/backup-export.ts",
    "backup:export:prod": "node dist/backup-export.mjs",
    "backup:restore": "tsx --env-file-if-exists=.env.local scripts/backup-restore.ts",
    "backup:restore:prod": "node dist/backup-restore.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1150.0",
    "@aws-sdk/s3-request-presigner": "3.1150.0",
    "@better-auth/core": "1.7.10",
    "@tailwindcss/postcss": "4.3.3",
    "age-encryption": "0.3.1",
    "better-auth": "1.7.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.4",
    "hast-util-to-mdast": "^10.1.2",
    "hast-util-to-text": "^4.0.2",
    "lucide-react": "^1.60.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-markdown": "^2.2.0",
    "mdast-util-to-string": "^4.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "pg": "8.23.1",
    "pino": "^10.4.0",
    "postcss": "^8.5.31",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-parse": "^9.0.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "4.3.3",
    "unified": "^11.0.5",
    "unpdf": "1.8.1",
    "uuid": "^14.0.3",
    "yauzl": "3.4.0",
    "yazl": "^3.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "1.56.1",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitest/coverage-v8": "4.1.12",
    "drizzle-kit": "0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
